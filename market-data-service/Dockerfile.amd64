# syntax=docker/dockerfile:1.7
# Build this file with Docker Buildx so the resulting image is explicitly
# compatible with Linux hosts using the amd64 (x86_64) architecture.
FROM --platform=linux/amd64 eclipse-temurin:21-jre

WORKDIR /market-data-service

ARG JAR_FILE=target/*.jar
COPY ${JAR_FILE} market-data-service.jar

ENTRYPOINT ["java", "-jar", "market-data-service.jar"]
